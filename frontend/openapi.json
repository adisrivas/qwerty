{
  "openapi": "3.1.0",
  "info": {
    "title": "Day-ahead Wind Forecast API",
    "summary": "Day-ahead wind forecast decision support (Elexon WINDFOR vs FUELHH).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "description": "Liveness and a quick sanity count of loaded data.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Meta",
        "description": "Scope, defaults, assumptions and data provenance.",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaDTO"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/decision-days": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Decision Days",
        "description": "Every supported decision day and the forecast issue that would be selected.",
        "operationId": "decision_days_api_v1_decision_days_get",
        "parameters": [
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction).",
              "examples": [
                "09:50",
                "09:20"
              ],
              "title": "Cutoff"
            },
            "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionDaysDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/forecast": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Forecast",
        "description": "Client question 1: the latest forecast available at the cutoff, plus context.",
        "operationId": "forecast_api_v1_forecast_get",
        "parameters": [
          {
            "name": "decision_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "Day the desk bids (YYYY-MM-DD).",
              "title": "Decision Date"
            },
            "description": "Day the desk bids (YYYY-MM-DD)."
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction).",
              "examples": [
                "09:50",
                "09:20"
              ],
              "title": "Cutoff"
            },
            "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionViewDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Accuracy",
        "description": "Client question 2: quantified error of the as-of forecasts over a date range.",
        "operationId": "accuracy_api_v1_accuracy_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First decision day, inclusive.",
              "title": "From"
            },
            "description": "First decision day, inclusive."
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last decision day, inclusive.",
              "title": "To"
            },
            "description": "Last decision day, inclusive."
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction).",
              "examples": [
                "09:50",
                "09:20"
              ],
              "title": "Cutoff"
            },
            "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyReportDTO"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/accuracy/export.csv": {
      "get": {
        "tags": [
          "v1"
        ],
        "summary": "Accuracy Export",
        "description": "Every compared hour as CSV, for the desk's own analysis.",
        "operationId": "accuracy_export_api_v1_accuracy_export_csv_get",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "name": "cutoff",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction).",
              "examples": [
                "09:50",
                "09:20"
              ],
              "title": "Cutoff"
            },
            "description": "Local UK gate-closure time, HH:MM. Defaults to the configured cutoff (09:50, the N2EX GB day-ahead auction)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccuracyReportDTO": {
        "properties": {
          "from_decision_date": {
            "type": "string",
            "format": "date",
            "title": "From Decision Date"
          },
          "to_decision_date": {
            "type": "string",
            "format": "date",
            "title": "To Decision Date"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "cutoff_local": {
            "type": "string",
            "title": "Cutoff Local"
          },
          "days_requested": {
            "type": "integer",
            "title": "Days Requested"
          },
          "days_compared": {
            "type": "integer",
            "title": "Days Compared"
          },
          "days_without_forecast": {
            "items": {
              "type": "string",
              "format": "date"
            },
            "type": "array",
            "title": "Days Without Forecast"
          },
          "hours_compared": {
            "type": "integer",
            "title": "Hours Compared"
          },
          "overall": {
            "$ref": "#/components/schemas/ErrorSummaryDTO"
          },
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BaselineDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "guidance": {
            "$ref": "#/components/schemas/ProcurementGuidanceDTO"
          },
          "band_backtest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BandBacktestDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "daily": {
            "items": {
              "$ref": "#/components/schemas/DailyAccuracyDTO"
            },
            "type": "array",
            "title": "Daily"
          },
          "by_hour_of_day": {
            "items": {
              "$ref": "#/components/schemas/HourOfDayDTO"
            },
            "type": "array",
            "title": "By Hour Of Day"
          },
          "by_issue_slot": {
            "items": {
              "$ref": "#/components/schemas/IssueSlotDTO"
            },
            "type": "array",
            "title": "By Issue Slot"
          },
          "by_forecast_band": {
            "items": {
              "$ref": "#/components/schemas/ForecastBandDTO"
            },
            "type": "array",
            "title": "By Forecast Band"
          },
          "histogram": {
            "$ref": "#/components/schemas/HistogramDTO"
          },
          "worst_over_forecast_hours": {
            "items": {
              "$ref": "#/components/schemas/WorstHourDTO"
            },
            "type": "array",
            "title": "Worst Over Forecast Hours"
          },
          "worst_under_forecast_hours": {
            "items": {
              "$ref": "#/components/schemas/WorstHourDTO"
            },
            "type": "array",
            "title": "Worst Under Forecast Hours"
          }
        },
        "type": "object",
        "required": [
          "from_decision_date",
          "to_decision_date",
          "timezone",
          "cutoff_local",
          "days_requested",
          "days_compared",
          "days_without_forecast",
          "hours_compared",
          "overall",
          "baseline",
          "guidance",
          "band_backtest",
          "daily",
          "by_hour_of_day",
          "by_issue_slot",
          "by_forecast_band",
          "histogram",
          "worst_over_forecast_hours",
          "worst_under_forecast_hours"
        ],
        "title": "AccuracyReportDTO",
        "description": "Quantified forecast error over a range of decision days (client question 2)."
      },
      "BandBacktestDTO": {
        "properties": {
          "target_pct": {
            "type": "integer",
            "title": "Target Pct"
          },
          "days_checked": {
            "type": "integer",
            "title": "Days Checked"
          },
          "days_without_history": {
            "type": "integer",
            "title": "Days Without History"
          },
          "hours_checked": {
            "type": "integer",
            "title": "Hours Checked"
          },
          "hours_covered": {
            "type": "integer",
            "title": "Hours Covered"
          },
          "coverage_pct": {
            "type": "number",
            "title": "Coverage Pct"
          }
        },
        "type": "object",
        "required": [
          "target_pct",
          "days_checked",
          "days_without_history",
          "hours_checked",
          "hours_covered",
          "coverage_pct"
        ],
        "title": "BandBacktestDTO",
        "description": "Did the out-of-sample 90% band actually cover 90% of hours?"
      },
      "BandPointDTO": {
        "properties": {
          "target_time": {
            "type": "string",
            "format": "date-time",
            "title": "Target Time"
          },
          "forecast_mw": {
            "type": "number",
            "title": "Forecast Mw"
          },
          "dependable_mw": {
            "type": "number",
            "title": "Dependable Mw",
            "description": "forecast - P90(error): reached in 9 past hours in 10."
          },
          "expected_mw": {
            "type": "number",
            "title": "Expected Mw",
            "description": "forecast - P50(error): median-bias-corrected."
          },
          "optimistic_mw": {
            "type": "number",
            "title": "Optimistic Mw",
            "description": "forecast - P10(error): upper edge of the band."
          }
        },
        "type": "object",
        "required": [
          "target_time",
          "forecast_mw",
          "dependable_mw",
          "expected_mw",
          "optimistic_mw"
        ],
        "title": "BandPointDTO",
        "description": "Forecast for one hour with its calibrated range (all MW, floored at zero)."
      },
      "BaselineDTO": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "e.g. 'persistence_48h': actual at the same hour two days earlier."
          },
          "hours": {
            "type": "integer",
            "title": "Hours"
          },
          "mae_mw": {
            "type": "number",
            "title": "Mae Mw"
          },
          "bias_mw": {
            "type": "number",
            "title": "Bias Mw"
          },
          "skill_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Skill Score",
            "description": "1 - MAE_forecast / MAE_baseline. 0 = no better than naive, 1 = perfect."
          }
        },
        "type": "object",
        "required": [
          "name",
          "hours",
          "mae_mw",
          "bias_mw",
          "skill_score"
        ],
        "title": "BaselineDTO",
        "description": "A naive forecast to judge the real one against."
      },
      "CalibrationDTO": {
        "properties": {
          "window_from_decision_date": {
            "type": "string",
            "format": "date",
            "title": "Window From Decision Date"
          },
          "window_to_decision_date": {
            "type": "string",
            "format": "date",
            "title": "Window To Decision Date"
          },
          "days_used": {
            "type": "integer",
            "title": "Days Used"
          },
          "hours_used": {
            "type": "integer",
            "title": "Hours Used"
          },
          "bias_mw": {
            "type": "number",
            "title": "Bias Mw"
          },
          "p10_mw": {
            "type": "number",
            "title": "P10 Mw"
          },
          "p50_mw": {
            "type": "number",
            "title": "P50 Mw"
          },
          "p90_mw": {
            "type": "number",
            "title": "P90 Mw"
          }
        },
        "type": "object",
        "required": [
          "window_from_decision_date",
          "window_to_decision_date",
          "days_used",
          "hours_used",
          "bias_mw",
          "p10_mw",
          "p50_mw",
          "p90_mw"
        ],
        "title": "CalibrationDTO",
        "description": "Error quantiles learned only from delivery days completed before the decision."
      },
      "CoverageOptionDTO": {
        "properties": {
          "confidence_pct": {
            "type": "integer",
            "title": "Confidence Pct"
          },
          "buffer_mw": {
            "type": "number",
            "title": "Buffer Mw"
          },
          "pct_of_mean_actual": {
            "type": "number",
            "title": "Pct Of Mean Actual"
          }
        },
        "type": "object",
        "required": [
          "confidence_pct",
          "buffer_mw",
          "pct_of_mean_actual"
        ],
        "title": "CoverageOptionDTO",
        "description": "Buffer needed to be covered in ``confidence_pct`` of hours."
      },
      "DailyAccuracyDTO": {
        "properties": {
          "decision_date": {
            "type": "string",
            "format": "date",
            "title": "Decision Date"
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "title": "Delivery Date"
          },
          "issue_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Time"
          },
          "hours_compared": {
            "type": "integer",
            "title": "Hours Compared"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorSummaryDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "energy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EnergyDTO"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "decision_date",
          "delivery_date",
          "issue_time",
          "hours_compared",
          "summary",
          "energy"
        ],
        "title": "DailyAccuracyDTO",
        "description": "Accuracy of the as-of forecast for one decision day."
      },
      "DecisionDayDTO": {
        "properties": {
          "decision_date": {
            "type": "string",
            "format": "date",
            "title": "Decision Date"
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "title": "Delivery Date"
          },
          "selected_issue_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Issue Time"
          },
          "hours_with_actuals": {
            "type": "integer",
            "title": "Hours With Actuals"
          }
        },
        "type": "object",
        "required": [
          "decision_date",
          "delivery_date",
          "selected_issue_time",
          "hours_with_actuals"
        ],
        "title": "DecisionDayDTO",
        "description": "One row of the decision-day index."
      },
      "DecisionDaysDTO": {
        "properties": {
          "cutoff_local": {
            "type": "string",
            "title": "Cutoff Local"
          },
          "days": {
            "items": {
              "$ref": "#/components/schemas/DecisionDayDTO"
            },
            "type": "array",
            "title": "Days"
          }
        },
        "type": "object",
        "required": [
          "cutoff_local",
          "days"
        ],
        "title": "DecisionDaysDTO",
        "description": "All decision days in scope."
      },
      "DecisionViewDTO": {
        "properties": {
          "decision_date": {
            "type": "string",
            "format": "date",
            "title": "Decision Date"
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "title": "Delivery Date"
          },
          "timezone": {
            "type": "string",
            "title": "Timezone"
          },
          "cutoff_local": {
            "type": "string",
            "title": "Cutoff Local"
          },
          "cutoff_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Cutoff Utc"
          },
          "delivery_window": {
            "$ref": "#/components/schemas/WindowDTO"
          },
          "selected_issue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IssueDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IssueDTO"
            },
            "type": "array",
            "title": "Issues"
          },
          "calibration": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CalibrationDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "band": {
            "items": {
              "$ref": "#/components/schemas/BandPointDTO"
            },
            "type": "array",
            "title": "Band"
          },
          "dependable_energy_mwh": {
