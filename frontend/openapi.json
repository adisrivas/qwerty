              "$ref": "#/components/schemas/ErrorPairDTO"
            },
            "type": "array",
            "title": "Comparison"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorSummaryDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BaselineDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "energy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EnergyDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "type": "object",
        "required": [
          "decision_date",
          "delivery_date",
          "timezone",
          "cutoff_local",
          "cutoff_utc",
          "delivery_window",
          "selected_issue",
          "issues",
          "calibration",
          "band",
          "dependable_energy_mwh",
          "actuals_half_hourly",
          "actuals_hourly",
          "comparison",
          "summary",
          "baseline",
          "energy",
          "notes"
        ],
        "title": "DecisionViewDTO",
        "description": "Everything the desk needs for one decision day (client question 1)."
      },
      "EnergyDTO": {
        "properties": {
          "hours": {
            "type": "integer",
            "title": "Hours"
