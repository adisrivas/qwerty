          "actuals_half_hourly": {
            "items": {
              "$ref": "#/components/schemas/PointDTO"
            },
            "type": "array",
            "title": "Actuals Half Hourly"
          },
          "actuals_hourly": {
            "items": {
              "$ref": "#/components/schemas/HourlyActualDTO"
            },
            "type": "array",
            "title": "Actuals Hourly"
